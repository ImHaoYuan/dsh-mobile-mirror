<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 只做浅色：刻意用 Light 父主题而不是 DayNight —— 不跟随系统深浅色。
         界面配色由 Compose 的 DshMirrorTheme 负责，这里只管窗口与系统栏。 -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
