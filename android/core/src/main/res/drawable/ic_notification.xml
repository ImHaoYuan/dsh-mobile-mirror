<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏小图标。必须是单色剪影：系统只取 alpha 通道。
     因此这里一律纯白填充 + 透明背景。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 手机外框：外矩形 + 内矩形，evenOdd 把内部挖空 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M7,2 L17,2 L17,22 L7,22 Z M9,4.5 L15,4.5 L15,19.5 L9,19.5 Z" />

    <!-- 会话两条 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,8 L15,8 L15,9.4 L11,9.4 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,11.5 L15,11.5 L15,12.9 L11,12.9 Z" />
</vector>
