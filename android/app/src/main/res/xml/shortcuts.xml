<?xml version="1.0" encoding="utf-8"?>
<!--
  静态 App 快捷方式：长按桌面上的 App 图标即可看到「超级岛诊断」。

  这是验证版的主入口。之前用的是"长按加载进度条"，但那个 View 在页面加载完
  会被设成 GONE —— GONE 的 View 收不到触摸事件，等于入口根本不存在。

  目标刻意指向 MainActivity 而不是 IslandTestActivity：这样 IslandTestActivity
  可以保持 exported="false"，App 里对外暴露的仍然只有 MainActivity 一个。
  由 MainActivity 读 action 再转发。

  验证结束后连同 IslandTestActivity 一起删除。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="island_diag"
        android:enabled="true"
        android:shortcutShortLabel="@string/island_shortcut_short"
        android:shortcutLongLabel="@string/island_shortcut_long">
        <intent
            android:action="dev.dsh.mirror.action.ISLAND_DIAG"
            android:targetClass="dev.dsh.mirror.MainActivity"
            android:targetPackage="dev.dsh.mirror" />
    </shortcut>

</shortcuts>
