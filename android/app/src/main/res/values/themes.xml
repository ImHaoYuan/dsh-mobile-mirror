<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight 父主题，跟随系统深浅色。windowActionBar/windowNoTitle 显式关掉标题栏
         （DeviceDefault 自带 ActionBar，会压在 WebView 上方）。 -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
